{
  "name": "convee",
  "version": "1.1.0",
  "description": "Private offline-first desktop file converter",
  "main": "src/main.js",
  "author": "convee contributors",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win nsis portable",
    "dist:mac": "electron-builder --mac dmg",
    "dist:linux": "electron-builder --linux AppImage deb",
    "test": "node --test"
  },
  "dependencies": {
    "pdf-lib": "^1.17.1",
    "sharp": "^0.33.5",
    "uiohook-napi": "^1.5.4",
    "chokidar": "^4.0.3",
    "@iarna/toml": "^2.2.5",
    "csv-parse": "^5.6.0",
    "csv-stringify": "^6.5.2",
    "fast-xml-parser": "^4.5.0",
    "yaml": "^2.6.1",
    "ffmpeg-static": "^5.2.0",
    "ffprobe-static": "^3.1.0",
    "7zip-bin": "^5.2.0",
    "marked": "^15.0.7"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.convee.desktop",
    "productName": "convee",
    "directories": {
      "output": "release"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/uiohook-napi/**/*",
      "node_modules/sharp/**/*",
      "node_modules/ffmpeg-static/**/*",
      "node_modules/ffprobe-static/**/*",
      "node_modules/7zip-bin/**/*"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "artifactName": "convee-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "mac": {
      "target": [
        "dmg"
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ]
    }
  }
}
